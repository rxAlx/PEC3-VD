## 4. Verificación rápida del enriquecimiento

```{r verificacion}
# Temperatura media por mes y hotel (debe mostrar diferencias estacionales)
x_enriquecido %>%
  group_by(hotel, arrival_date_month, mes_num) %>%
  summarise(temp_media_mensual = mean(temp_media, na.rm = TRUE),
            .groups = "drop") %>%
  arrange(mes_num) %>%
  pivot_wider(names_from = hotel, values_from = temp_media_mensual) %>%
  select(mes_num, arrival_date_month, `City Hotel`, `Resort Hotel`) %>%
  knitr::kable(digits = 1,
               col.names = c("Mes nº", "Mes", "Lisboa (°C)", "Algarve (°C)"),
               caption = "Temperatura media mensual por hotel (promedio 2015-2017)")
```

