## 1. Carga y limpieza del dataset hotelero

```{r load_hotel}
# Ajusta la ruta si es necesario
x <- read.csv("./data/hotel_bookings.csv", stringsAsFactors = TRUE,
              na.strings = c("", "NA"))
dim(x)  # 119,390 filas x 32 columnas
```

### Limpieza de outliers (siguiendo el notebook original)

```{r clean_hotel}
# Eliminar reservas con >= 10 adultos
x <- x[x$adults < 10, ]

# Eliminar ADR negativos o extremos (>= 1000)
x <- x[x$adr >= 0 & x$adr < 1000, ]

# Reemplazar NAs en children por 0
x[is.na(x$children), "children"] <- 0

# Eliminar estancias sin noches, sin coste o sin huéspedes
x <- x[x$adr > 0 &
       (x$stays_in_week_nights + x$stays_in_weekend_nights) > 0 &
       (x$adults + x$children + x$babies) > 0, ]

dim(x)
```

### Crear variable de fecha de llegada y tipo de visita

```{r fecha_tipo}
# Fecha de llegada (columna 'dia')
x$dia <- as_date(paste0(x$arrival_date_year, "-",
                         x$arrival_date_month, "-",
                         x$arrival_date_day_of_month))

# Clasificación del tipo de visita
x$tipo <- ifelse(x$stays_in_weekend_nights == 0, "Trabajo",
          ifelse(x$stays_in_week_nights == 0, "Fin de semana",
          ifelse(x$stays_in_week_nights == 1 & wday(x$dia) == 6, "Fin de semana",
          ifelse(x$stays_in_week_nights == 5 &
                 (x$stays_in_weekend_nights == 3 |
                  x$stays_in_weekend_nights == 4), "Paquete vacacional",
          ifelse(x$stays_in_week_nights <= 5 &
                 x$stays_in_weekend_nights < 3, "Trabajo + descanso",
          "Vacaciones")))))

# Número de mes como entero (para el join climático)
mes_map <- c("January"=1,"February"=2,"March"=3,"April"=4,
             "May"=5,"June"=6,"July"=7,"August"=8,
             "September"=9,"October"=10,"November"=11,"December"=12)

x$mes_num <- mes_map[as.character(x$arrival_date_month)]

cat("Registros tras limpieza:", nrow(x), "\n")
cat("Período:", as.character(min(x$dia)), "→", as.character(max(x$dia)), "\n")
```

