## 3. Enriquecimiento: join hotel + clima

Hacemos join por `arrival_date_year` + `mes_num` + `hotel` (Ciudad Hotel → Lisboa, Resort Hotel → Faro).

```{r join_clima}
# Tabla de correspondencia hotel → ciudad climática
x <- x %>%
  mutate(ciudad_clima = ifelse(hotel == "City Hotel", "Lisboa", "Faro (Algarve)"))

# Preparar tabla climática para el join (una fila por ciudad/año/mes)
clima_join <- clima_periodo %>%
  select(anio, mes_num, ciudad, temp_media, temp_max_med, prec_total) %>%
  rename(ciudad_clima = ciudad)

# Join
x_enriquecido <- x %>%
  left_join(clima_join,
            by = c("arrival_date_year" = "anio",
                   "mes_num"           = "mes_num",
                   "ciudad_clima"      = "ciudad_clima"))

cat("Filas con temperatura asignada:",
    sum(!is.na(x_enriquecido$temp_media)), "\n")
cat("Filas sin temperatura (NAs):",
    sum(is.na(x_enriquecido$temp_media)), "\n")

glimpse(x_enriquecido %>% select(hotel, arrival_date_month, arrival_date_year,
                                  ciudad_clima, temp_media, prec_total))
```

